<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AndroidTVDebloater.Localization"
             x:Class="AndroidTVDebloater.Views.WelcomeView">
  <UserControl.Styles>
    <Style Selector="Border.num">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.num > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ficon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.ficon > Path">
      <Setter Property="Stroke" Value="{DynamicResource AccentFg}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="TextBlock.feature">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="44,38,44,40" MaxWidth="860" HorizontalAlignment="Left" Spacing="22">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="{l:T Welcome_Title}" TextWrapping="Wrap" />
        <TextBlock Classes="lead" Text="{l:T Welcome_Lead}" />
      </StackPanel>

      <UniformGrid Columns="3">
        <Border Classes="card" Margin="0,0,8,0">
          <StackPanel Spacing="6">
            <Border Classes="ficon"><Path Data="M12 3 L19 6 V11 C19 15.5 16 19 12 21 C8 19 5 15.5 5 11 V6 Z M9 12 L11 14 L15 10" /></Border>
            <TextBlock Classes="feature" Text="{l:T Welcome_F1Title}" />
            <TextBlock Classes="muted" Text="{l:T Welcome_F1Text}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="4,0,4,0">
          <StackPanel Spacing="6">
            <Border Classes="ficon"><Path Data="M4 12 A8 8 0 1 0 6.5 6.2 M4 4 V8 H8" /></Border>
            <TextBlock Classes="feature" Text="{l:T Welcome_F2Title}" />
            <TextBlock Classes="muted" Text="{l:T Welcome_F2Text}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="8,0,0,0">
          <StackPanel Spacing="6">
            <Border Classes="ficon"><Path Data="M5 5 H19 V19 H5 Z M8.5 12 L11 14.5 L15.5 9.5" /></Border>
            <TextBlock Classes="feature" Text="{l:T Welcome_F3Title}" />
            <TextBlock Classes="muted" Text="{l:T Welcome_F3Text}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="h2" Text="{l:T Welcome_PrepTitle}" />
          <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
            <Border Classes="num"><TextBlock Text="1" /></Border>
            <TextBlock Grid.Column="1" Classes="muted" Text="{l:T Welcome_Step1}" />
            <Border Grid.Row="1" Classes="num"><TextBlock Text="2" /></Border>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" Text="{l:T Welcome_Step2}" />
            <Border Grid.Row="2" Classes="num"><TextBlock Text="3" /></Border>
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" Text="{l:T Welcome_Step3}" />
            <Border Grid.Row="3" Classes="num"><TextBlock Text="4" /></Border>
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="muted" Text="{l:T Welcome_Step4}" />
          </Grid>
          <TextBlock Classes="muted" Text="{l:T Welcome_StepFire}" />
          <Border Classes="note">
            <TextBlock Classes="muted" Text="{l:T Welcome_Supported}" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Classes="h2" Text="{l:T Welcome_ToolsTitle}" />
            <Border Classes="pill" HorizontalAlignment="Right" IsVisible="{Binding ToolsReady}">
              <TextBlock Text="{l:T Welcome_ToolsPill}" />
            </Border>
          </DockPanel>
          <TextBlock Classes="muted" Text="{Binding ToolsStatus}" />
          <StackPanel Spacing="6" IsVisible="{Binding IsDownloading}">
            <TextBlock Classes="faint" Text="{l:T Welcome_Downloading}" />
            <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" />
          </StackPanel>
          <Border Classes="err" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrFg}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <Button Classes="accent big" Content="{l:T Welcome_Continue}"
              Command="{Binding ContinueCommand}" IsEnabled="{Binding !IsDownloading}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
